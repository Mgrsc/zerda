# polling_timeout = 30                  # default 30
# split_delay_ms = 100                  # default 100

[tts]
provider = "minimax"                    # only "minimax" supported, empty = disabled
api_key = "${MINIMAX_API_KEY}"
model = "speech-2.8-hd"                # default "speech-2.8-hd"
voice_id = "female-shaonv"

[stt]
provider = "groq"                       # only "groq" supported, empty = disabled
api_key = "${GROQ_API_KEY}"
model = "whisper-large-v3-turbo"        # default "whisper-large-v3-turbo"

[log]
level = "info"                          # trace | debug | info | warn | error, default "info"
