# zerda complete configuration template
# All values here are defaults; adjust as needed.
# ${VAR} syntax expands environment variables at load time.
# Define MCP servers in mcp.toml (see mcp.toml.example).

[provider]
name = "openai_chat"                    # openai_chat | openai_responses | anthropic
api_key = "${OPENAI_API_KEY}"
base_url = "${OPENAI_BASE_URL}"         # leave empty to use the provider default endpoint
model = "${OPENAI_MODEL}"
temperature = 1.0
max_tokens = 4096
vision = true                           # whether to include image inputs

# [provider.extra_headers]
# "HTTP-Referer" = "https://example.com"
# "X-Title" = "zerda"

[provider.retry]
max_retries = 3
base_delay_ms = 2000
max_delay_ms = 30000
connect_timeout_secs = 10
request_timeout_secs = 120

[agent]
max_iterations = 10                     # maximum tool calls per turn
max_history = 30                        # trigger compression when non-system messages exceed this value
max_tool_output_chars = 30000           # truncate tool output above this threshold
max_memory_tokens = 2000                # maximum token count for memory tool content
identity_path = "~/.zerda/identity.md"  # path to the system prompt file
show_usage = false                      # print token usage at the end of each turn
# max_budget_tokens = 1000000           # session token budget; stop when exceeded (optional, unlimited by default)
confirm_tools = []                      # tools requiring manual confirmation, e.g. ["shell", "write"]
max_memory_file_size = 102400           # maximum memory file size in bytes
session_cleanup_days = 7                # auto-clean sessions older than N days
tool_timeout = 300                      # tool execution timeout in seconds

# Compression model (optional; compression is unavailable if omitted)
[agent.compression_model]
name = "openai_chat"
api_key = "${OPENAI_API_KEY}"
base_url = "${OPENAI_BASE_URL}"
model = "${OPENAI_COMPRESSION_MODEL}"
temperature = 0.3
max_tokens = 4096
vision = false

# Subagent model (optional; falls back to compression_model, and subagent tool is not registered if both are missing)
# [agent.subagent]
# name = "openai_chat"
# api_key = "${OPENAI_API_KEY}"
# base_url = "${OPENAI_BASE_URL}"
# model = "${OPENAI_SUBAGENT_MODEL}"
# temperature = 0.3
# max_tokens = 4096
# vision = false

# [[channels]]
# name = "telegram"                     # currently only telegram is supported
# token = "${TELEGRAM_BOT_TOKEN}"
# allowed_users = ["*"]                 # allowed user IDs; ["*"] means all users
# max_message_length = 4096

# TTS (optional; disabled when provider is empty)
[tts]
provider = "minimax"                    # minimax
api_key = "${MINIMAX_API_KEY}"
model = "speech-2.8-hd"
voice_id = "female-shaonv"

# STT (optional; disabled when provider is empty)
[stt]
provider = "groq"                       # groq
api_key = "${GROQ_API_KEY}"
model = "whisper-large-v3-turbo"

[log]
level = "info"                          # trace | debug | info | warn | error
