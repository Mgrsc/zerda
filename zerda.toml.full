# zerda complete configuration template
# Fields marked as required have no code default and must be set explicitly.
# Other values are aligned with code defaults.
# ${VAR} syntax expands environment variables at load time.
# Define MCP servers in mcp.toml (see mcp.toml.example).

# [providers.<id>] defines a provider endpoint.
# <id> is user-defined and used in model references: /model <id>@<model_name>

[providers.openai]
type = "openai_chat"                    # required: openai_chat | openai_responses | anthropic
api_key = "${OPENAI_API_KEY}"           # required
base_url = ""                           # API root up to version path, e.g. https://api.openai.com/v1
                                        # the provider appends /chat/completions, /responses, or /messages
                                        # leave empty to use the official default endpoint

# [providers.openai.extra_headers]
# "HTTP-Referer" = "https://example.com"
# "X-Title" = "zerda"

# [providers.openai.retry]
# max_retries = 3
# base_delay_ms = 2000
# max_delay_ms = 30000
# connect_timeout_secs = 10
# request_timeout_secs = 120

# [providers.anthropic]
# type = "anthropic"
# api_key = "${ANTHROPIC_API_KEY}"

[agent]
max_iterations = 10                     # maximum tool calls per turn
max_history = 30                        # trigger compression when non-system messages exceed this value
max_tool_output_chars = 30000           # truncate tool output above this threshold
identity_path = "~/.zerda/identity.md"  # default path to the system prompt file
show_usage = false                      # print token usage at the end of each turn
# max_budget_tokens = 1000000           # session token budget; stop when exceeded (optional, unlimited by default)
session_cleanup_days = 7                # auto-clean sessions older than N days
tool_timeout = 300                      # tool execution timeout in seconds
disabled_primitives = []                # blacklist primitive names; all primitives are enabled when empty

[agent.primary_model]
model = "openai@${OPENAI_MODEL}"        # required: provider_id@model_name
vision = true                           # whether to send images to the model (default: true)
# temperature = 1.0                     # optional; default: unset (API decides)
# top_p = 1.0                           # optional; default: unset (API decides)
# max_tokens = 4096                     # optional; default: unset (anthropic uses 4096)

# [agent.fast_model]                    # optional; falls back to primary_model if omitted
# model = "openai@gpt-5.3"
# vision = false
# temperature = 1.0
# top_p = 1.0
# max_tokens = 4096

# Reflection memory loop (heuristic, concept-inspired; requires Qdrant + OPENAI_API_KEY for embeddings)
[reflection]
enabled = false                         # enable executor reflection memory loop
llm_model = "openai@gpt-4.1-mini"      # reflection analysis/compression model (provider_id@model_name)
# max_tokens = 2048                     # optional; default: 2048
# embedding_dim = 1536                  # embedding vector dimension; must match your model (e.g. bge-m3 = 1024)
# embedding_model = "openai@text-embedding-3-small"  # optional; defaults to "<reflection.llm_model provider>@text-embedding-3-small"
# Both reflection model and embedding model resolve base_url/api_key from [providers.<id>]
# Reflection sampling is fixed: temperature=0.7, top_p=0.95

# [[channels]]
# name = "telegram"                     # currently only telegram is supported
# token = "${TELEGRAM_BOT_TOKEN}"
# allowed_users = []                    # default: empty means all users
# max_message_length = 4096
# draft_stream_update_interval_ms = 350

# TTS (optional; disabled when provider is empty)
[tts]
provider = ""                           # default: disabled
# api_key = "${MINIMAX_API_KEY}"
model = "speech-2.8-hd"
# voice_id = "female-shaonv"            # optional; default is unset

# STT (optional; disabled when provider is empty)
[stt]
provider = ""                           # default: disabled
# api_key = "${GROQ_API_KEY}"
model = "whisper-large-v3-turbo"

# Memory service (MemBurrow; disabled by default)
[memory_service]
enabled = false                         # set true to enable MemBurrow integration
url = "http://localhost:8080"           # MemBurrow base URL (without trailing /)
auth_token = "${MEMBURROW_AUTH_TOKEN}"  # Bearer token used by Authorization header
tenant_id = "default"                   # must match X-Tenant-ID header and request body
default_entity_id = "user_default"      # fallback entity_id when channel/user id is unavailable
process_id = "planner"                  # memory namespace segment (e.g. planner / __shared__)
recall_timeout_ms = 3000                # timeout for /v1/memory/recall requests
recall_top_k = 8                        # max recall items requested per turn
recall_min_score = 0.6                  # items below this score are filtered before LLM injection
ingest_batch_turns = 3                  # flush ingest every N turns; set 1 for per-turn ingest
ingest_timeout_ms = 10000               # timeout for /v1/memory/ingest and /feedback
ingest_max_retries = 2                  # retry count for 5xx ingest/feedback errors

[log]
level = "info"                          # trace | debug | info | warn | error
