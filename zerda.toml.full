# Full zerda configuration template
# ${VAR} expands from environment variables at load time
# MCP servers can be defined here or in mcp.toml; both are merged
# subagent falls back to compression_model if not configured; neither present = no subagent tool

[provider]
name = "openai_chat"                    # openai_chat | openai_responses | anthropic
api_key = "${OPENAI_API_KEY}"
base_url = "${OPENAI_BASE_URL}"         # empty = provider built-in URL
model = "${OPENAI_MODEL}"
temperature = 0.7                       # 0.0 - 2.0, default 1.0
max_tokens = 4096                       # default 4096
vision = true                           # pass image input to model, default true

[provider.extra_headers]
# "HTTP-Referer" = "https://example.com"
# "X-Title" = "zerda"

[provider.retry]
max_retries = 3                         # default 3
base_delay_ms = 2000                    # default 2000
max_delay_ms = 30000                    # default 30000
connect_timeout_secs = 10               # default 10
request_timeout_secs = 120              # default 120

[agent]
max_iterations = 10                     # max tool calls per turn, default 10
max_history = 30                        # trigger compression when non-system messages exceed this, default 30
max_tool_output_chars = 30000           # truncate tool output at this length, default 30000
max_memory_tokens = 2000                # max tokens for memory tool, default 2000
identity_path = "~/.zerda/identity.md"  # system prompt file path, default "identity.md"
memory_dir = "~/.zerda"                 # memory/session storage directory, default "~/.zerda"
shell_timeout = 300                     # shell tool timeout in seconds, default 300
show_usage = false                      # print token usage after each turn, default false
# max_budget_tokens = 1000000           # session token budget, stop when exceeded, default unlimited
confirm_tools = []                      # tools requiring manual approval, e.g. ["shell", "write"], default []
max_memory_file_size = 102400           # max memory file size in bytes, default 102400
compression_summary_max_chars = 4000    # max chars for compression summary, default 4000
session_cleanup_days = 7                # auto-delete sessions older than N days, default 7
compression_transcript_max_chars = 12000 # max original transcript chars kept during compression, default 12000
stream_overflow_chars = 4000            # streaming overflow buffer chars, default 4000
# tool_timeout = 120                    # general tool timeout in seconds, default unlimited
max_prompt_chars = 32000                # max user input chars, default 32000

[agent.compression_model]
name = "openai_chat"
api_key = "${OPENAI_API_KEY}"
base_url = "${OPENAI_BASE_URL}"
model = "${OPENAI_COMPRESSION_MODEL}"
temperature = 0.3
max_tokens = 4096
vision = false

# [agent.subagent]
# name = "openai_chat"
