ZERDA_CONFIG=/root/.zerda/zerda.toml

OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_COMPRESSION_MODEL=gpt-5.1-mini

ANTHROPIC_API_KEY=sk-ant-xxxxx

TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

MINIMAX_API_KEY=
GROQ_API_KEY=

FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Optional override for primitives root in non-default runtime layouts
# ZERDA_PRIMITIVES_ROOT=/usr/local/share/zerda/code_primitives/python

# Zerda document search (Cloudflare AI Search backend)
CF_AI_SEARCH_ACCOUNT_ID=
CF_AI_SEARCH_API_TOKEN=
CF_AI_SEARCH_INSTANCE_NAME=

# ACON reflection system (Qdrant vector store)
QDRANT_URL=http://localhost:6334
# QDRANT_API_KEY=
# Embedding API for ACON (falls back to OPENAI_BASE_URL / OPENAI_API_KEY if unset)
# ACON_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ACON_EMBEDDING_API_KEY=sk-xxxxx
# ACON_EMBEDDING_MODEL=text-embedding-3-small

# MemBurrow memory service
MEMBURROW_AUTH_TOKEN=
